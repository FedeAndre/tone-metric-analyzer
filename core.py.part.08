                        rr = by.get(rest_child.get(cid))
                        return _rest_duration(rr.get('shape') if rr is not None else '')
                    hs = chord_heads.get(cid, [])
                    if any(head_is_black.get(h, False) for h in hs):
                        base = Fraction(1,4)
                    else:
                        shapes = [(by[h].get('shape