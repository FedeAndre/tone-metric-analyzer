{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.dissertation"
  },
  "deploy": {
    "startCommand": "python3 -m uvicorn --app-dir /app dissertation_app:app --host 0.0.0.0 --port 8080",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
