=m.gridBottom+Math.max(4,m.rowH*.56),markerH=Math.max(3,m.rowH*.28);arr.sort((a,b)=>Number(a.pivot_index)-Number(b.pivot_index));arr.forEach(o=>{const kind=o.kind==='compound'?'compound':'simple',cls=kind==='compound'?'pivotMarkerPDF pivotMarkerCompoundPDF':'pivotMarkerPDF',x=Number(o.cx_norm)*w;if(!Number.isFinite(x))return;const nextX=waves.find(wx=>wx>x+.01),hitEnd=Number.isFinite(nextX)?nextX:Math.max(x,Number(m.right));const markerW=Math.max(1,hitEnd-x);const title=`${kind==='compound'?'Compound':'Simple'} pivot · structural-turning moment at m. ${escapeHtml(o.pivot_measure_number??o.start_measure_number??'')} +${escapeHtml(o.pivot_offset_in_measure_quarter??o.start_offset_in_measure_quarter??'')} · drop depth ${escapeHtml(o.drop_depth??'')} · marker spans the full rendered width of this wave hit`;svg+=`<rect class="${cls}" x="${x.toFixed(2)}" y="${y.toFixed(2)}" width="${markerW.toFixed(2)}" height="${markerH.toFixed(2)}"><title>${title}</title></rect>`;});});return svg;}
 function drawTrees(svg,pp,models,w,showScale=false){const by=new Map();treeBranches(pp).forEach(o=>{const k=Number(o.system_index||0);if(!by.has(k))by.set(k,[]);by.get(k).push(o);});[...by.keys()].sort((a,b)=>a-b).forEach(k=>{const m=models.get(k),arr=by.get(k)||[];if(!m||!arr.length)return;if(showScale){svg+=`<text class="treeTitlePDF" x="${Math.max(3,m.left-4)}" y="${Math.max(9,m.gridTop-3)}">Tree</text>`;for(let level=1;level<=m.maxLevel;level++){svg+=`<text class="treeRowLabelPDF" x="${Math.max(3,m.left-5)}" y="${yForLevel(m,level)}">${level}</text>`;}}arr.sort((a,b)=>Number(a.branch_index)-Number(b.branch_index));arr.forEach(o=>{const role=o.span_role||'complete';const title=`Tree branch ${escapeHtml(o.branch_index??'')} · m. ${escapeHtml(o.source_measure_number??'')} +${escapeHtml(o.source_offset_in_measure_quarter??'')} L${escapeHtml(o.source_level??'')} → m. ${escapeHtml(o.target_measure_number??'')} +${escapeHtml(o.target_offset_in_measure_quarter??'')} L${escapeHtml(o.target_level??'')}${role==='complete'?'':' · continues across printed system/page'}`;if(role==='complete'){const x1=Number(o.source_cx_norm)*w,x2=Number(o.target_cx_norm)*w,y1=yForLevel(m,Number(o.source_level)),y2=yForLevel(m,Number(o.target_level));if(![x1,x2,y1,y2].every(Number.isFinite))return;svg+=`<line class="treeBranchPDF" x1="${x1.toFixed(2)}" y1="${y1.toFixed(2)}" x2="${x2.toFixed(2)}" y2="${y2.toFixed(2)}"><title>${title}</title></line>`;}else{const x=Number(o.cx_norm)*w,level=Number(o.endpoint_level),y=yForLevel(m,level);if(!Number.isFinite(x)||!Number.isFinite(y))return;const stub=Math.max(8,m.rowH*1.5);let x1,x2;if(role==='source-endpoint'){x1=x;x2=Math.min(m.right,x+stub);}else{x1=Math.max(m.left,x-stub);x2=x;}svg+=`<line class="treeContinuationPDF" x1="${x1.toFixed(2)}" y1="${y.toFixed(2)}" x2="${x2.toFixed(2)}" y2="${y.toFixed(2)}"><title>${title}</title></line>`;}});});return svg;}
 function drawLayers(svg,pp,models,w,includeStructural=false){const attackBy=new Map(),structBy=new Map();attackLayerAnchors(pp).forEach(o=>{const k=Number(o.system_index||0);if(!attackBy.has(k))attackBy.set(k,[]);attackBy.get(k).push(o);});if(includeStructural)structuralLayerAnchors(pp).forEach(o=>{const k=Number(o.system_index||0);if(!structBy.has(k))structBy.set(k,[]);structBy.get(k).push(o);});const keys=[...new Set([...attackBy.keys(),...structBy.keys()])];keys.forEach(k=>{const arr=attackBy.get(k)||[],structs=structBy.get(k)||[],m=models.get(k);if(!m)return;arr.sort((a,b)=>Number(a.cx_norm)-Number(b.cx_norm));structs.sort((a,b)=>Number(a.cx_norm)-Number(b.cx_norm));svg+=`<text class="layerTitlePDF" x="${Math.max(3,m.left-4)}" y="${Math.max(9,m.gridTop-3)}">Levels</text>`;for(let level=1;level<=m.maxLevel;level++){const y=yForLevel(m,level);svg+=`<text class="layerRowLabelPDF" x="${Math.max(3,m.left-5)}" y="${y}">${level|</text>`;}arr.forEach(o=>{const ax=Number(o.cx_norm)*w;if(!Number.isFinite(ax))return;svg+=`<line class="attackLayerGuidePDF" x1="${ax}" y1="${m.gridTop}" x2="${ax}" y2="${m.top}"/>`;for(const raw of (o.levels||[])){const level=Number(raw);if(!Number.isFinite(level)||level<1)continue;const y=yForLevel(m,level);svg+=`<text class="layerTextPDF" x="${ax}" y="${y}">${level}<title>m. ${escapeHtml(o.measure_number??'')} · score time ${escapeHtml(o.onset_quarter??'')} · onset ${escapeHtml(o.offset_in_measure_quarter??'')} · recursive level ${level} · actual attack · recovered x ${ax.toFixed(1)}</title></text>`;}});if(includeStructural)structs.forEach(o=>{const ax=Number(o.cx_norm)*w;if(!Number.isFinite(ax))return;svg+=`<line class="structuralLayerGuidePDF" x1="${ax}" y1="${m.gridTop}" x2="${ax}" y2="${m.top}"/>`;for(const raw of (o.levels||[])){const level=Number(raw);if(!Number.isFinite(level)||level<1)continue;const y=yForLevel(m,level),estimated=o.visual_position_is_estimated?'display position estimated from canonical measure layout':'exact non-attack notation column';svg+=`<text class="structuralLayerTextPDF" x="${ax}" y="${y}">(${level})<title>m. ${escapeHtml(o.measure_number??'')} · score time ${escapeHtml(o.onset_quarter??'')} · onset ${escapeHtml(o.offset_in_measure_quarter??'')} · parenthetical structural level ${level} · ${escapeHtml(o.structural_reason??'no new attack')} · ${estimated}</title></text>`;}});});return svg;}
 function paint(){const p=pages[pageIndex],w=p.width,h=p.height,pp=physicalPage(),usingPhysical=!!(physical.available&&pp&&((pp.layer_anchors||[]).length||(pp.structural_anchors||[]).length||(pp.wave_anchors||[]).length||(pp.pivot_anchors||[]).length||(pp.tree_nodes||[]).length||(pp.tree_branches||[]).length)),showAttackLayers=usingPhysical&&(mode==='attacks'||mode==='full'||mode==='fullwave'||mode==='fullanalysis'||mode==='fulltree'),includeStructural=mode==='full'||mode==='fullwave'||mode==='fullanalysis'||mode==='fulltree',showWave=usingPhysical&&(mode==='waves'||mode==='fullwave'||mode==='wavepivots'||mode==='fullanalysis'||mode==='fulltree'),howPivots=usingPhysical&&(mode==='wavepivots'||mode==='fullanalysis'