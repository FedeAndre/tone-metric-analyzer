from __future__ import annotations

"""Canonical score-time recovery for scanned PDF scores.

The tone-metric algorithm must operate in musical time, not in PDF geometry.  This
module reads Audiveris' saved notation graph and builds a measure-local metric grid
first.  Recognized note/rest columns are then assigned to that grid.  PDF x/y is kept
only as provenance for the later drawing stage.

Important rules implemented here:
- augmentation dots extend duration but never create attacks;
- tie continuations occupy a score position but do not create attacks;
- rests occupy score time but do not create attacks;
- an attack in any other voice at the same position still creates a global hit;
- simultaneous/near-coincident noteheads are one physical attack column;
- Audiveris BEGIN slot times are useful constraints, but contradictory ones cannot
  reorder the printed score.  A maximum feasible monotonic subset is used as anchors;
- missing semantic slots are filled on an exact rational metric lattice.  Geometry is
  used only to choose among positions already generated by that lattice.
"""

from collections import Counter, defaultdict
from dataclasses import asdict, dataclass
from fractions import Fraction
from io import BytesIO
from math import gcd
from pathlib import Path, PurePosixPath
from zipfile import ZipFile
import re

import numpy as np
from lxml import etree
from PIL import Image

from .models import Hit


def _local(tag: str) -> str:
    return tag.rsplit("}", 1)[-1].lower()


def _frac(value) -> Fraction | None:
    try:
        return Fraction(str(value))
    except Exception:
        return None


def _int(value, default=None):
    try:
        return int(float(str(value)))
    except Exception:
        return default


def _bounds(el):
    b = next((c for c in el if _local(c.tag) == "bounds"), None)
    if b is None:
        return None
    try:
        return tuple(float(b.get(k)) for k in ("x", "y", "w", "h"))
    except Exception:
        return None


def _median_points(stem_el):
    med = next((c for c in stem_el if _local(c.tag) == "median"), None)
    if med is None:
        return None
    pts = [c for c in med if _local(c.tag) in {"p1", "p2"}]
    if len(pts) < 2:
        return None
    try:
        return (
            (float(pts[0].get("x")), float(pts[0].get("y"))),
            (float(pts[1].get("x")), float(pts[1].get("y"))),
        )
    except Exception:
        return None


def _page_image(zf: ZipFile, sheet_member: str):
    folder = str(PurePosixPath(sheet_member).parent)
    for name in ("BINARY.png", "GRAY.png"):
        member = f"{folder}/{name}"
        if member in zf.namelist():
            im = Image.open(BytesIO(zf.read(member))).convert("L")
            im.load()
            return im
    return None


def _sheet_no(member: str) -> int:
    m = re.search(r"sheet#(\d+)", member, re.I)
    return int(m.group(1)) if m else 10**9


def _corridor_fraction(arr: np.ndarray, p1, p2, offset: float, half: int = 2) -> float:
    x1, y1 = p1
    x2, y2 = p2
    if abs(x2 - x1) < 6:
        return 0.0
    xa = int(min(x1, x2)) + 3
    xb = int(max(x1, x2)) - 3
    if xb <= xa:
        return 0.0
    dark = total = 0
    for x in range(xa, xb + 1):
        t = (x - x1) / (x2 - x1)
        y = y1 + t * (y2 - y1) + offset
        yi = int(round(y))
        y0 = max(0, yi - half)
        y1i = min(arr.shape[0], yi + half + 1)
        col = arr[y0:y1i, x]
        dark += int(np.count_nonzero(col < 128))
        total += int(col.size)
    return dark / total if total else 0.0


def _beam_band_count(arr: np.ndarray, a: dict, b: dict, interline: float) -> int:
    """Supplement missing semantic beam relations from the saved OMR raster.

    Stem direction is used only for local beam recognition, never for voice/timing.
    """
    if not a.get("distal") or not b.get("distal"):
        return 0
    if a.get("direction") != b.get("direction"):
        return 0
    p1, p2 = a["distal"], b["distal"]
    if abs(p2[0] - p1[0]) > max(140.0, interline * 7.0):
        return 0
    inward = 1.0 if a["direction"] == "up" else -1.0
    offsets = [inward * x for x in np.arange(-3.0, max(9.0, interline * 1.55), 2.0)]
    vals = [_corridor_fraction(arr, p1, p2, off, half=2) for off in offsets]
    active = [v >= 0.47 for v in vals]
    clusters = []
    i = 0
    while i < len(active):
        if not active[i]:
            i += 1
            continue
        j = i
        peak = vals[i]
        while j + 1 < len(active) and active[j + 1]:
            j += 1
            peak = max(peak, vals[j])
        if peak >= 0.58 and (j - i + 1) >= 2:
            clusters.append((i, j, peak))
        i = j + 1
    return min(4, len(clusters))


def _head_kind(head_shapes: list[str]) -> str:
    text = " ".join(head_shapes).upper()
    if "WHOLE" in text:
        return "whole"
    if "VOID" in text or "HALF" in text:
        return "half"
    return "black"


def _rest_duration(shape: str) -> Fraction | None:
    s = (shape or "").upper()
    if "LONG_REST" in s:
        return Fraction(8)
    if "WHOLE_REST" in s:
        return Fraction(4)
    if "HALF_REST" in s:
        return Fraction(2)
    if "QUARTER_REST" in s:
        return Fraction(1)
    if "EIGHTH_REST" in s:
        return Fraction(1, 2)
    m = re.search(r"(?:ONE_)?(\d+)(?:TH|ND|ST|RD)_REST", s)
    if m:
        den = int(m.group(1))
        if den > 0:
            return Fraction(4, den)
    return None


def _dot_multiplier(count: int) -> Fraction:
    out = Fraction(1)
    add = Fraction(1, 2)
    for _ in range(max(0, count)):
        out += add
        add /= 2
    return out


def _fraction_gcd(values: list[Fraction]) -> Fraction:
    vals = [v for v in values if v is not None and v > 0]
    if not vals:
        return Fraction(1, 2)
    den = 1
    for v in vals:
        den = den * v.denominator // gcd(den, v.denominator)
    nums = [int(v * den) for v in vals]
    g = nums[0]
    for n in nums[1:]:
        g = gcd(g, n)