[],structurals=structuralBy.get(k)||[],waves=waveBy.get(k)||[],pivots=pivotBy.get(k)||[],treeNodes=treeNodeBy.get(k)||[],treeBranches=treeBranchBy.get(k)||[],bound=boundsBy.get(k)||null;let top=bound?bound.top_norm*h:h,bottom=bound?bound.bottom_norm*h:0,left=bound?bound.left_norm*w:w,right=bound?bound.right_norm*w:0,guardBottom=bound?bound.guard_bottom_norm*h:null;const boxHeights=[];ovs.forEach(o=>{left=Math.min(left,o.cx_norm*w);right=Math.max(right,o.cx_norm*w);(o.boxes||[]).forEach(b=>{if(!bound){top=Math.min(top,b.y_norm*h);bottom=Math.max(bottom,(b.y_norm+b.h_norm)*h);}left=Math.min(left,b.x_norm*w);right=Math.max(right,(b.x_norm+b.w_norm)*w);boxHeights.push(b.h_norm*h);});});if(!Number.isFinite(top)||top>=h){top=ovs.length?Math.min(...ovs.map(o=>o.cy_norm*h)):0;}let systemMax=1;[...layers,...structurals,...waves].forEach(o=>{systemMax=Math.max(systemMax,...(o.levels||[]).map(Number));});boxHeights.sort((a,b)=>a-b);const medH=boxHeights.length?boxHeights[Math.floor(boxHeights.length/2)]:8;return {k:Number(k),ovs,layers,structurals,waves,pivots,treeNodes,treeBranches,top,bottom,left,right,guardBottom,systemMax,medH};}).sort((a,b)=>a.top-b.top);
  const targetRowH=Math.max(7,Math.min(10,h*0.0068)),titleH=Math.max(12,targetRowH*1.45),gapMargin=Math.max(5,h*0.0035);const insertions=[];let cumulativeExtra=0;
  systems.forEach((s,idx)=>{const prev=idx?systems[idx-1]:null,prevReservedRaw=prev?(Number.isFinite(prev.guardBottom)?prev.guardBottom:prev.bottom):0,clearance=Math.max(12,s.medH*2.8,h*0.007),naturalGap=Math.max(0,s.top-prevReservedRaw),requiredGap=titleH+s.systemMax*targetRowH+clearance+gapMargin;const extra=expandBands?Math.max(0,Math.ceil(requiredGap-naturalGap)):0;if(extra>0){const insertY=idx?prevReservedRaw:s.top;insertions.push({y:insertY,extra});cumulativeExtra+=extra;}const shift=cumulativeExtra,shiftedTop=s.top+shift,shiftedBottom=s.bottom+shift,shiftedGuard=Number.isFinite(s.guardBottom)?s.guardBottom+shift:null,gridBottom=shiftedTop-clearance,gridTop=gridBottom-s.systemMax*targetRowH,padX=Math.max(6,w*0.003);models.set(s.k,{rowH:targetRowH,gridBottom,gridTop,top:shiftedTop,bottom:shiftedBottom,guardBottom:shiftedGuard,left:Math.max(2,s.left-padX),right:Math.min(w-2,s.right+padX),maxLevel:s.systemMax,shift});});
  return {models,insertions,expandedH:h+insertions.reduce((n,x)=>n+x.extra,0),originalH:h};
 }
 function expandedPageHtml(p,w,h,layout){if(!layout?.insertions?.length)return `<img src="${p.url}" width="${w}" height="${h}" alt="Uploaded score page ${pageIndex+1}">`;const ins=[...layout.insertions].sort((a,b)=>a.y-b.y);let srcY=0,dstY=0,html=`<div class="pageComposite" style="width:${w}px;height:${layout.expandedH}px">`;ins.forEach(g=>{const y=Math.max(srcY,Math.min(h,g.y)),sliceH=Math.max(0,y-srcY);if(sliceH>0){html+=`<div class="pageSlice" style="top:${dstY}px;width:${w}px;height:${sliceH}px"><img src="${p.url}" width="${w}" height="${h}" style="top:${-srcY}px" alt=""></div>`;dstY+=sliceH;}dstY+=g.extra;srcY=y;});const tail=Math.max(0,h-srcY);if(tail>0)html+=`<div class="pageSlice" style="top:${dstY}px;width:${w}px;height:${tail}px"><img src="${p.url}" width="${w}" height="${h}" style="top:${-srcY}px" alt=""></div>`;return html+'</div>';}
 function yForLevel(model,level){return model.gridBottom-(Math.max(1,level)-0.5)*model.rowH;}
 function attackLayerAnchors(pp){return (pp?.layer_anchors||[]).filter(o=>Number.isFinite(Number(o.cx_norm))&&o.levels?.length);}
 function structuralLayerAnchors(pp){return (pp?.structural_anchors||[]).filter(o=>Number.isFinite(Number(o.cx_norm))&&o.levels?.length);}
 function waveAnchors(pp){return (pp?.wave_anchors||[]).filter(o=>Number.isFinite(Number(o.cx_norm))&&Number(o.height)>0);}
 function pivotAnchors(pp){return (pp?.pivot_anchors||[]).filter(o=>Number.isFinite(Number(o.cx_norm))&&['simple','compound'].includes(o.kind));}
 function treeNodes(pp){return (pp?.tree_nodes||[]).filter(o=>Number.isFinite(Number(o.cx_norm))&&Number(o.lowest_level)>0&&o.attack===true);}
 function treeBranches(pp){return (pp?.tree_branches||[]).filter(o=>['complete','source-endpoint','target-endpoint'].includes(o.span_role));}
 function yForWaveHeight(model,height){return model.gridBottom-Math.max(0,Number(height)||0)*model.rowH;}
 function drawWave(svg,pp,models,w){const by=new Map();waveAnchors(pp).forEach(o=>{const k=Number(o.system_index||0);if(!by.has(k))by.set(k,[]);by.get(k).push(o);});[...by.keys()].sort((a,b)=>a-b).forEach(k=>{const m=models.get(k),arr=by.get(k)||[];if(!m||!arr.length)return;arr.sort((a,b)=>Number(a.cx_norm)-Number(b.cx_norm));const pts=arr.map(o=>({x:Number(o.cx_norm)*w,y:yForWaveHeight(m,o.height),h:Number(o.height),o})).filter(p=>Number.isFinite(p.x)&&Number.isFinite(p.y));if(!pts.length)return;let top=`M ${pts[0].x.toFixed(2)} ${pts[0].y.toFixed(2)}`;for(let i=1;i<pts.length;i++){top+=` H ${pts[i].x.toFixed(2)} V ${pts[i].y.toFixed(2)}`;}const base=m.gridBottom.toFixed(2),fill=`M ${pts[0].x.toFixed(2)} ${base} L ${pts[0].x.toFixed(2)} ${pts[0].y.toFixed(2)}${top.slice(top.indexOf(' H '))} L ${pts[pts.length-1].x.toFixed(2)} ${base} Z`;svg+=`<path class="waveFillPDF" d="${fill}"/>`;svg+=`<path class="waveEnvelopePDF" d="${top}"><title>Tone-metric wave: highest occupied recursive Level at each score-time position; derived from ${pts.length} validated grid point(s) in this system.</title></path>`;svg+=`<text class="waveTitlePDF" x="${Math.max(3,m.left-4)}" y="${Math.max(9,m.gridTop-3)}">Wave</text>`;});return svg;}
 function drawPivots(svg,pp,models,w){const by=new Map(),waveBy=new Map();pivotAnchors(pp).forEach(o=>{const k=Number(o.system_index||0);if(!by.has(k))by.set(k,[]);by.get(k).push(o);});waveAnchors(pp).forEach(o=>{const k=Number(o.system_index||0);if(!waveBy.has(k))waveBy.set(k,[]);waveBy.get(k).push(o);});[...by.keys()].sort((a,b)=>a-b).forEach(k=>{const m=models.get(k),arr=by.get(k)||[],waves=(waveBy.get(k)||[]).map(o=>Number(o.cx_norm)*w).filter(Number.isFinite).sort((a,b)=>a-b);if(!m||!arr.length)return;const y