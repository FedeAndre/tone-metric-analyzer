pivots'||mode==='fullanalysis'||mode==='fulltree'),showTrees=usingPhysical&&(mode==='trees'||mode==='fulltree'),showAnalysis=showAttackLayers||showWave||showPivots||showTrees,expandBands=showAnalysis,layout=usingPhysical?buildPageLayout(pp,w,h,expandBands):{models:new Map(),insertions:[],expandedH:h,originalH:h},renderH=expandBands?layout.expandedH:h;let svg=`<svg viewBox="0 0 ${w} ${renderH}" width="${w}" height="${renderH}">`;if(showWave)svg=drawWave(svg,pp,layout.models,w);if(showAttackLayers)svg=drawLayers(svg,pp,layout.models,w,includeStructural);if(showPivots)svg=drawPivots(svg,pp,layout.models,w);if(showTrees)svg=drawTrees(svg,pp,layout.models,w,!showAttackLayers);svg+='</svg>';const pageHtml=expandBands?expandedPageHtml(p,w,h,layout):`<img src="${p.url}" width="${w}" height="${h}" alt="Uploaded score page ${pageIndex+1}">`;surface.innerHTML=`${pageHtml}${svg}`;surface.style.transform=`scale(${zoom/100})`;surface.style.marginRight=`${Math.max(0,(zoom/100-1)*w)}px`;surface.style.marginBottom=`${Math.max(0,(zoom/100-1)*renderH)}px`;label.textContent=`Page ${pageIndex+1} / ${pages.length}`;slider.value=zoom;zoomLabel.textContent=`${zoom}%`;document.getElementById('page-prev').disabled=pageIndex===0;document.getElementById('page-next').disabled=pageIndex===pages.length-1;Object.entries(modeButtons).forEach(([k,b])=>b.classList.toggle('active',mode===k));explanation.textContent=modeExplanation[mode];const structuralCount=(pp?.structural_anchors||[]).length,waveCount=(pp?.wave_anchors||[]).length,pivotPieces=(pp?.pivot_anchors||[]).length,treeNodeCount=(pp?.tree_nodes||[]).length,treePieceCount=(pp?.tree_branches||[]).length;document.getElementById('actual-legend').innerHTML=mode==='attacks'?`<span>Normal numbers = actual attacks. Recursive Levels 1–${physical?.matching?.max_layer_level||0}.</span>`:mode==='full'?`<span>Normal numbers = actual attacks; parenthetical numbers = structural articulations with no new attack. ${structuralCount} parenthetical position(s) on this page.</span>`:mode==='waves'?`<span>Shaded envelope = tone-metric wave derived from ${waveCount} recursive grid point(s) on this page.</span>`:mode==='fullwave'?`<span>Full recursive grid plus derived tone-metric wave. ${structuralCount} parenthetical position(s); ${waveCount} wave point(s) on this page.</span>`:mode==='wavepivots'?`<span>Wave plus pivot moments. Each horizontal marker spans the full rendered width of the wave hit at the structural turning point. Light grey = simple; dark grey = compound. ${pivotPieces} pivot marker(s) on this page.</span>`:mode==='fullanalysis'?`<span>Full recursive grid, wave, and pivot moments. Light grey = simple pivot; dark grey = compound pivot.</span>`:mode==='trees'?`<span>Tone-metric tree: ${treeNodeCount} actual event node(s), ${treePieceCount} visible branch piece(s) on this page. Nodes use each event's lowest occupied Level.</span>`:mode==='fulltree'?`<span>Full recursive grid, wave, pivots, and tone-metric tree. Tree branches connect actual sonic events only.</span>`:'';if(statusBox){const mm=physical?.matching||{},pl=mm.per_level||{},summary=Object.keys(pl).sort((a,b)=>Number(a)-Number(b)).map(k=>`L${k} ${pl[k].mapped||0}/${pl[k].expected||0}`).join('; '),structTotal=Number(mm.structural_parenthetical_positions||0),structMapped=Number(mm.structural_parenthetical_labels_mapped||0),structExpected=Number(mm.structural_parenthetical_labels_expected||0),waveMapped=Number(mm.wave_profile_points_mapped||0),waveExpected=Number(mm.wave_profile_points_expected||0),pivotMapped=Number(mm.pivot_profile_mapped||0),pivotExpected=Number(mm.pivot_profile_expected||0),treeNodesMapped=Number(mm.tree_event_nodes_mapped||0),treeNodesExpected=Number(mm.tree_event_nodes_expected||0),treeBranchesMapped=Number(mm.tree_branches_mapped||0),treeBranchesExpected=Number(mm.tree_branches_expected||0);statusBox.textContent=usingPhysical?`Page ${pageIndex+1}: ${(pp?.layer_anchors||[]).length} attack column(s), recursive Levels through L${mm.max_layer_level||0}. ${summary}. Parenthetical structural grid: ${structTotal} position(s), ${structMapped}/${structExpected} level label(s) placed. Wave: ${waveMapped}/${waveExpected} score-time point(s) mapped. Pivots: ${pivotMapped}/${pivotExpected} mapped (${mm.simple_pivots||0} simple, ${mm.compound_pivots||0} compound). Trees: ${treeNodesMapped}/${treeNodesExpected} nodes, ${treeBranchesMapped}/${treeBranchesExpected} branches mapped.${expandBands&&layout.insertions.length?` Analytical spacing added: ${layout.expandedH-h}px.`:''}`:`Page ${pageIndex+1}: canonical visual placement unavailable; no attack, wave, pivot, or tree event positions are guessed.`;}}
 document.getElementById('page-prev').addEventListener('click',()=>{if(pageIndex>0){pageIndex--;paint();stage.scrollTo({left:0,top:0});}});document.getElementById('page-next').addEventListener('click',()=>{if(pageIndex<pages.length-1){pageIndex++;paint();stage.scrollTo({left:0,top:0});}});slider.addEventListener('input',()=>{zoom=Number(slider.value);paint();});Object.entries(modeButtons).forEach(([k,b])=>b.addEventListener('click',()=>{mode=k;paint();}));paint();
}
</script>
</main></body></html>
