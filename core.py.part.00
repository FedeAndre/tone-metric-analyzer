from __future__ import annotations

from collections import defaultdict
from dataclasses import dataclass, field
from fractions import Fraction
from io import BytesIO
from pathlib import Path
from statistics import median
from zipfile import ZipFile
import re

import numpy as np
from PIL import Image
from lxml import etree


def loc(tag):
    return tag.rsplit('}', 1)[-1].lower() if isinstance(tag, str) else ''


@dataclass(frozen=True)
class Box:
    x: float
    y: float
    w: float
    h: float
    @property
    def cx(self): return self.x + self.w / 2
    @property
    def cy(self): return self.y + self.h / 2


@dataclass
class Chord:
    id: str
    page: int
    system: int
    measure: int
    staff: str
    box: Box
    head_ids: list[str]
    attack_head_ids: list[str]
    attack_head_xs: list[float]
    stem_id: str | None
    direction: str | None
    x: float
    referenced: bool = False
    part: int | None = None
    voice: str | None = None
    old_onset: Fraction | None = None
    onset: Fraction | None = None
    duration: Fraction | None = None
    tie_start: bool = False


@dataclass(frozen=True)
class Strike:
    page_index: int
    system_index: int
    measure_index: int
    x: float
    system_top: float
    system_bottom: float
    omr_width: float
    omr_height: float
    recovered: bool = False


@dataclass
class Hit:
    measure: int
    onset: Fraction
    chords: list[Chord] = field(default_factory=list)
    slot_x: float | None = None


@dataclass(frozen=True)
class Diagnostics:
    total_hits: int
    semantic_attack_chords: int
    referenced_attack_chords: int
    recovered_attack_chords: int
    retimed_referenced_chords: int
    corrected_head_shapes: int
    completed_beam_edges: int
    unresolved_attack_chords: int
    synthetic_strike_positions: int


def get_box(node) -> Box | None:
    if node is None:
        return None
    b = next((c for c in node if loc(c.tag) == 'bounds'), None)
    if b is None:
        return None
 