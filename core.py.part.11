n = set()
                for seed in adj:
                    if seed in seen:
                        continue
                    comp = []
                    stack = [seed]
                    seen.add(seed)
                    while stack:
                        q = stack.pop()
                        comp.append(q)
                        for n in adj[q]:
                            if n not in seen:
                                seen.add(n)
                                stack.append(n)
                    cs = [chords[c] for c in comp if c in chords]
                    if not cs or not any(not c.referenced for c in cs):
                        continue
                    cs.sort(key=lambda c:c.x)
                    anchors = [(i,c.onset) for i,c in enumerate(cs) if c.referenced and c.onset is not None]
                    if anchors:
                        ai, anchor_t = min(anchors, key=lambda q:q[0])
                        times = [None]*len(cs)
                        times[ai] = anchor_t
                        for i in range(ai+1,len(cs)):
                            times[i] = times[i-1] + cs[i-1].duration
                        for i in range(ai-1,-1,-1):
                            times[i] = times[i+1] - cs[i].duration
                        for c, tt in zip(cs,times):
                            if not c.referenced:
                                c.onset = tt
                        continue

                    mi = cs[0].measure - sys_base - 1
                    candidates = []
                    existing = [c for c in chords.values() if c.measure == cs[0].measure and c.referenced and c.onset is not None and c.staff != cs[0].staff and c.attack_head_ids]
                    for q in existing:
                        if abs(q.x-cs[0].x) > .40*il:
                            continue
                        ts = [q.onset]
                        for c in cs[:-1]:
                            ts.append(ts[-1] + c.duration)
             